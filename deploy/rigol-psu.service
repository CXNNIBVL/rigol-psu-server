[Unit]
Description=Rigol DP832 bench control server
Documentation=https://git.ksat-stuttgart.de/source/src_collab-projects/rigol-psu-server
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/rigol-psu-server --config /etc/rigol-psu/config.toml
# Set this to an account that already exists on the machine — no user and no
# group is created for this service. The install step in deploy/README.md
# rewrites this line to whoever is running it.
#
# The supplies are reachable because the udev rule sets MODE="0666", not because
# of group membership, so any ordinary account can drive them. Left as root it
# works too, just with more privilege than the job needs. Change it after the
# first start and /var/lib/rigol-psu needs chowning to match, since
# StateDirectory= creates it owned by whoever is named here.
User=root

# The server releases every front panel on SIGTERM. Give it room to do so
# before being killed, or the supplies stay locked and only the mains switch
# will clear them.
KillSignal=SIGTERM
TimeoutStopSec=15

Restart=on-failure
RestartSec=5

# The server never de-energises a channel it did not energise, so a restart
# leaves running experiments powered and adopts them on the way back up.

# Hardening. The service needs its device nodes, its config and its database,
# and nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
StateDirectory=rigol-psu
ReadWritePaths=/var/lib/rigol-psu
# `char-usb` is the device group name for major 180 as listed in /proc/devices,
# which is what DeviceAllow takes. It is NOT the udev subsystem name: udev calls
# these devices `usbmisc` and the rule in 99-rigol.rules matches on that, but
# writing `char-usbmisc` here names a group that does not exist. It matches
# nothing, and because any DeviceAllow= at all closes the policy, every open of
# the supplies is then denied by the device cgroup with EPERM — regardless of
# the mode on the node.
DeviceAllow=char-usb rw

[Install]
WantedBy=multi-user.target
